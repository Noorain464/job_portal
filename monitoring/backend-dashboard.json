{
  "__inputs": [
    {"name": "DS_PROMETHEUS", "label": "Prometheus", "type": "datasource", "pluginId": "prometheus", "pluginName": "Prometheus"}
  ],
  "title": "Job Portal Backend",
  "uid": "job-portal-backend",
  "schemaVersion": 39,
  "time": {"from": "now-15m", "to": "now"},
  "refresh": "10s",
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "Requests per second (by route)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "targets": [{"refId": "A", "legendFormat": "{{route}}",
        "expr": "sum by (route) (rate(http_request_duration_seconds_count{job=\"backend\",route!~\"/healthz|/readyz|/metrics\"}[1m]))"}]
    },
    {
      "id": 2, "type": "timeseries", "title": "5xx error ratio",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []},
      "targets": [{"refId": "A", "legendFormat": "errors / all requests",
        "expr": "(sum(rate(http_request_duration_seconds_count{job=\"backend\",status=~\"5..\",route!~\"/healthz|/readyz|/metrics\"}[1m])) or vector(0)) / sum(rate(http_request_duration_seconds_count{job=\"backend\",route!~\"/healthz|/readyz|/metrics\"}[1m]))"}]
    },
    {
      "id": 3, "type": "timeseries", "title": "p95 latency",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "targets": [{"refId": "A", "legendFormat": "p95",
        "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"backend\",route!~\"/healthz|/readyz|/metrics\"}[1m])))"}]
    },
    {
      "id": 4, "type": "stat", "title": "Backend replicas available",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"refId": "A",
        "expr": "kube_deployment_status_replicas_available{deployment=\"backend\"}"}]
    }
  ]
}
